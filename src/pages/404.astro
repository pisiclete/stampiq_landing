---
// 404 page, doubling as the QR landing for scan codes (/r/<CODE>), subscription
// codes (/p/<CODE>) and printed album page labels (/s/<SCAN_ID>).
//
// A promo QR encodes https://stampiq.io/r/<CODE> or https://stampiq.io/p/<CODE>.
// This is a plain content page with NO JavaScript redirect on those paths: an
// interstitial JS redirect breaks universal-link resolution and is what made the
// app open and then bounce back to Safari / the store. With that gone, iOS
// resolves the universal link cleanly — the app opens and redeems on the first
// scan. Apple's Smart App Banner (the apple-itunes-app meta tag) is the
// recommended affordance: installed → "Open" launcher, not installed → install.
// Android gets a Play Store link.
//
// /r vs /p vs /s differ only in copy: /r grants bonus scans (auto-redeemed on a
// second scan), /p grants a subscription tier (also enterable by hand at signup,
// so the code is shown), /s opens one collector's own scan and shows nothing to
// anyone else. The path prefix is read on load to pick the strings.
//
// Localisation: this page is served for an unprefixed URL, so it can't use the
// [lang] routing, and redirecting to a localised URL would reintroduce the JS
// navigation that breaks the link. Instead we ship every language's strings
// (from translations.json) and swap the TEXT only on load, based on the saved
// preference or navigator.language — no navigation. Strings fall back to English
// until a language's values are filled. The only redirect is for genuine
// 404s and never runs on /r/ or /p/.
import PromoPage from '../components/PromoPage.astro';
---

<PromoPage mode="auto">
  <Fragment slot="head">
    <script is:inline>
      // Writes the banner tag rather than patching one already in the document:
      // Safari reads apple-itunes-app when the parser reaches it, so a later
      // setAttribute would not put app-argument on the banner.
      (function () {
        var content = 'app-id=6760778035';
        var path = location.pathname || '';
        if (/^\/(p|r|s)\//.test(path)) {
          content += ', app-argument=' + location.origin + path;
        }
        document.write(
          '<meta name="apple-itunes-app" content="' + content + '">'
        );
      })();
    </script>
    <noscript><meta name="apple-itunes-app" content="app-id=6760778035" /></noscript>
  </Fragment>
</PromoPage>
