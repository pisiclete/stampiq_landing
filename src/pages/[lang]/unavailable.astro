---
import Layout from '../../layouts/Layout.astro';
import UnavailablePage from '../../components/UnavailablePage.jsx';
import { tFor } from '../../i18n/lookup.js';
import { PREFIXED_LANGS } from '../../i18n/langs.mjs';

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const title = tFor(lang, 'unavailable.page_title');
const description = tFor(lang, 'unavailable.meta_description');
const canonical = `https://stampiq.io/${lang}/unavailable.html`;
---
<Layout {lang} {title} {description} {canonical}>
  <UnavailablePage {lang} client:load />
</Layout>
