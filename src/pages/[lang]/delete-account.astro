---
import Layout from '../../layouts/Layout.astro';
import DeleteAccountPage from '../../components/legal/DeleteAccountPage.jsx';
import { tFor } from '../../i18n/lookup.js';
import { PREFIXED_LANGS } from '../../i18n/langs.mjs';

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const title = tFor(lang, 'delete.page_title');
const description = tFor(lang, 'delete.meta_description');
const canonical = `https://stampiq.io/${lang}/delete-account.html`;
---
<Layout {lang} {title} {description} {canonical}>
  <DeleteAccountPage {lang} client:load />
</Layout>
