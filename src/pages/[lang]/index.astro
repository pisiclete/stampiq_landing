---
import Layout from '../../layouts/Layout.astro';
import App from '../../components/App.jsx';
import { metaFor } from '../../i18n/meta.js';
import { PREFIXED_LANGS } from '../../i18n/langs.mjs';

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const meta = metaFor(lang);
const canonical = `https://stampiq.io/${lang}/`;
---
<Layout lang={lang} title={meta.title} description={meta.description} canonical={canonical}>
  <App lang={lang} client:load />
</Layout>
